  </diagram>
  <diagram id="notes" name="Design notes">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="P-MOSFET design notes" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#174A8B;" vertex="1" parent="1">
          <mxGeometry x="30" y="25" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="target" value="&lt;b&gt;Target behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. DUT_PROBE_ENABLE high impedance → Q1 OFF → MT9700 EN LOW.&lt;br&gt;&lt;br&gt;2. DUT_PROBE_ENABLE actively driven to 0 V → Q1 ON → MT9700 EN follows USB2514B PWRx.&lt;br&gt;&lt;br&gt;GPIO driven high is not a supported state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#1769C2;fontSize=14;fontColor=#17365D;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="vals" value="&lt;b&gt;Starting values&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q1: P-channel MOSFET&lt;br&gt;R1: 50 kΩ (GPIO-to-gate series resistor)&lt;br&gt;R2: 10 kΩ (EN pull-down)&lt;br&gt;R3: 1 MΩ (gate-to-source pull-up)&lt;br&gt;&lt;br&gt;With GPIO low, R1/R3 set VGS to about −VPWRx × 1 MΩ/(1 MΩ + 50 kΩ), approximately −95% of PWRx." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F7EF;strokeColor=#229B62;fontSize=14;fontColor=#174A36;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="parts" value="&lt;b&gt;Checking JLC parts C15127 / C10487&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check the current listing and datasheet for:&lt;br&gt;• P-channel polarity&lt;br&gt;• VDS rating ≥ maximum PWRx&lt;br&gt;• VGS(max) above worst-case source-to-gate voltage&lt;br&gt;• RDS(on) specified at the available VGS (not just −10 V)&lt;br&gt;• Package and S/G/D pinout&lt;br&gt;&lt;br&gt;Do not assume suitability from the part number alone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8E63C5;fontSize=14;fontColor=#38205E;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="910" height="250" as="geometry" />
        </mxCell>
        <mxCell id="important" value="&lt;b&gt;Important&lt;/b&gt;&lt;br&gt;Gate pull-up only establishes Q1 OFF if the source/PWRx net has a defined voltage. If PWRx can float or be unpowered, check that power sequence separately. Ensure the EN high level remains above the MT9700 input threshold." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#E6B84A;fontSize=13;fontColor=#674B00;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="910" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
