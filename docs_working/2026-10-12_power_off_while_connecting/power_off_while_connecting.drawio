        <mxCell id="warn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#E6B84A;fontSize=12;fontColor=#674B00;spacing=7;" value="&lt;b&gt;Design checks&lt;/b&gt;&lt;br&gt;• Verify Q1 VDS and VGS(max) against PWRx.&lt;br&gt;• Confirm RDS(on) is specified at the available gate drive.&lt;br&gt;• Confirm PWRx minus MOSFET drop meets MT9700 EN VIH.&lt;br&gt;• R2 = 10 kΩ loads PWRx when Q1 is on." vertex="1">
          <mxGeometry height="230" width="350" x="590" y="480" as="geometry" />
        </mxCell>
