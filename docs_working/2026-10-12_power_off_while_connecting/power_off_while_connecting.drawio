        <mxCell id="cell33" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#17365D;whiteSpace=wrap;strokeColor=#9DB7D8;fillColor=#F3F7FD;" value="Follows PWRx" vertex="1">
