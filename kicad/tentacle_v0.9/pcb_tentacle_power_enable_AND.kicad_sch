	(text "Power enable AND"
		(exclude_from_sim no)
		(at 58.928 70.866 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "06e07c0f-6acc-4746-b441-8e5bdc5e69fc")
	)
	(text "SITUATION WITHOUT THIS SCHEMATIC\nWhen the tentacle is connected, linux will power on all USB ports.\nThis is unwanted: DUT and RP_PROBE should not be powered!\n\nSITUATION WITH THIS SCHEMATIC\nWhen the tentacle is connected, DUT and RP_PROBE will NOT be powered.\nAs soon as DUT_PROBE_ENABLE is set to VCC, USB port power will work as expected.\n"
		(exclude_from_sim no)
		(at 129.794 145.542 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left bottom)
		)
		(uuid "161adf46-b882-4ce0-919b-3bf92893ff9d")
	)
	(text "Sequence\n\nConnect tentacle:\n  EN_IN is 1\n  EN_OUT is 0\n  DUT is NOT powered\nOctoprobe starts:\n  * Set USB hub power off: EN_IN is 0, EN_OUT is 0\n  * Set DUT_PROBE_ENABLE to VCC: EN_OUT not follows EN_IN"
		(exclude_from_sim no)
		(at 64.516 148.59 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left bottom)
		)
		(uuid "356e3d59-9059-4a7a-8de3-9631aea27d1f")
	)
	(text "Bridging will power on DUT/RP_PROBE when plugged in.\nNormally NOT bridged."
		(exclude_from_sim no)
		(at 101.854 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left bottom)
		)
		(uuid "52b97c35-5aa3-4aad-947c-b5abeb35a424")
	)
	(text "DUT_POWER_ENABLE EN_IN EN_OUT Command\nhigh impedance     0     0    After connecting tentacle\nhigh impedance     0     0    After connecting tentacle\n1                  0     0    After octoprobe initialized tentacle\n1                  1     1    After octoprobe initialized tentacle"
		(exclude_from_sim no)
